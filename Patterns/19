import java.util.*;
class Main {
    public static void main(String[] args) {
       Scanner sc=new Scanner(System.in);
       int n=sc.nextInt();
       
     for(int i=0;i<n;i++){
         //stars
         for(int j=n;j>i;j--){
             System.out.print(" * ");
         }
         //space 
         for(int j=0;j<2*i;j++){
             System.out.print("   ");
         }
         //stars
         for(int j=n;j>i;j--){
             System.out.print(" * ");
         }
         
       System.out.println();
     }
     for(int i=n;i>0;i--){
         for(int j=0;j<=(n-i);j++){
             System.out.print(" * ");
         }
         //space 
         for(int j=2*(i-1);j>0;j--){
             System.out.print("   ");
         }
          for(int j=0;j<=(n-i);j++){
             System.out.print(" * ");
         }
          System.out.println();
     }
       
      
       
    }
}

