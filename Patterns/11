import java.util.*;
class Main {
    public static void main(String[] args) {
       Scanner sc=new Scanner(System.in);
       int n=sc.nextInt();
       
       for (int i=0;i<n;i++){
           int k=0;
           if (i%2==0){
                   
                   k=1;
               }
           for(int j=0;j<=i;j++){
               System.out.print(" "+k+" ");
               k=1-k;
           }
       System.out.println();
       
       }
       
    }
}
