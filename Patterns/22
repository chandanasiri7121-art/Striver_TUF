import java.util.*;
class Main {
    public static void main(String[] args) {
       Scanner sc=new Scanner(System.in);
       int n=sc.nextInt();
       
    for(int i=0;i<2*n-1;i++){
        for(int j=0;j<2*n-1;j++){
            
            int l=i;
            int r=(2*n-2-i);
            int t=j;
            int b=(2*n-2-j);
            System.out.print(" "+(n-Math.min(Math.min(t,b),Math.min(r,l)))+" ");
        }
        System.out.println();
    }
       
    }
}
