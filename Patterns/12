import java.util.*;
class Main {
    public static void main(String[] args) {
       Scanner sc=new Scanner(System.in);
       int n=sc.nextInt();
       
       for(int i=0;i<n;i++){ 
          int l=0;
          //numbers
         for (int j=0;j<=i;j++){
             System.out.print(" "+(j+1)+" ");
             l=j+1;
         }
         //spaces
         for(int j=0;j<2*(n-1-i);j++){
             System.out.print("   ");
         }
         //numbers 
        for (int j=0;j<=i;j++){
             System.out.print(" "+(l)+" ");
             l--;
         }
       System.out.println();
       
       }
       
    }
}
