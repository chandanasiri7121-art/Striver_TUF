import java.util.*;
class Main {
    public static void main(String[] args) {
       Scanner sc=new Scanner(System.in);
       int n=sc.nextInt();
       
       for(int i=0;i<n;i++){
           char s=(char)('A'+n-i-1);
           for(int j=0;j<=i;j++){
               
               System.out.print(" "+(char)(s+j)+" ");
           }
           System.out.println();
       }
   
       
      
       
    }
}
