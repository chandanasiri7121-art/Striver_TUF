import java.util.*;
class Main {
    public static void main(String[] args) {
       Scanner sc=new Scanner(System.in);
       int n=sc.nextInt();
       
       for (int i=n-1;i>=0;i--){
           char k='A';
           int l=0;
        //spaces
        for(int j=0;j<i;j++){
            System.out.print("   ");
            l++;
        }
        //letters
        for(int j=0;j<2*(n-i-1)+1;j++){
            if( l>=n-1){
                 System.out.print(" "+(char)(k--)+" ");
                 l++;
            }
            else{
            System.out.print(" "+(char)(k++)+" ");
            l++;
            }
        }
        //spaces
        for(int j=0;j<i;j++){
            System.out.print("   ");
            l++;
        }
       System.out.println();
       
       }
       
    }
}

